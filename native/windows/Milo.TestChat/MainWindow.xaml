<Window x:Class="Milo.TestChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milo TestChat"
        Width="760"
        Height="720"
        MinWidth="520"
        MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel>
        <TextBlock FontSize="25" FontWeight="SemiBold" Text="Milo TestChat" />
        <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <Border x:Name="InstanceBadge" Margin="16,0,0,0" Padding="12,7" HorizontalAlignment="Right" Background="{DynamicResource PanelBrush}" CornerRadius="12" DockPanel.Dock="Right">
        <TextBlock x:Name="InstanceText" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </DockPanel>

    <TextBlock Grid.Row="1" Margin="0,24,0,10" Foreground="{DynamicResource MutedBrush}" Text="Synthetic conversation — no network, persistence, or real messages" TextWrapping="Wrap" />

    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
      <ScrollViewer x:Name="ConversationScroll" AutomationProperties.Name="Synthetic conversation surface" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ConversationHost" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal">
      <Button x:Name="AppendButton" MinHeight="44" Margin="0,0,10,0" Padding="18,8" AutomationProperties.Name="Append synthetic message" Click="AppendButton_OnClick" Content="Append message" />
      <Button x:Name="RecreateButton" MinHeight="44" Margin="0,0,10,0" Padding="18,8" AutomationProperties.Name="Close and recreate fixture window" Click="RecreateButton_OnClick" Content="Close + recreate window" />
      <Button x:Name="CloseButton" MinHeight="44" Padding="18,8" AutomationProperties.Name="Close fixture window" Click="CloseButton_OnClick" Content="Close window" />
    </StackPanel>

    <TextBlock Grid.Row="4" Margin="0,16,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" Text="UIA mode exposes message text through standard controls. OCR-only mode draws the same text without a readable UIA text tree." TextWrapping="Wrap" />
  </Grid>
</Window>
