<Application x:Class="Milo.TestChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#121827" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1B2435" />
    <SolidColorBrush x:Key="LineBrush" Color="#34415A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AEB9CF" />
    <SolidColorBrush x:Key="SelfBubbleBrush" Color="#5B6DF8" />
    <SolidColorBrush x:Key="OtherBubbleBrush" Color="#2B3850" />
  </Application.Resources>
</Application>
