{
  "name": "@milo/root",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @milo/web dev",
    "desktop:dev": "pnpm --filter @milo/desktop dev",
    "desktop:build": "pnpm --filter @milo/desktop build",
    "desktop:test": "pnpm --filter @milo/desktop test",
    "desktop:package": "pnpm --filter @milo/desktop package",
    "preview:local": "pnpm --filter @milo/web preview:local",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @milo/web start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @milo/web test:watch",
    "test:e2e": "playwright test --config=e2e/web/playwright.config.ts",
    "test:e2e:production": "playwright test --config=e2e/web/playwright.production.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/web/playwright.config.ts --ui",
    "test:desktop:security": "node scripts/desktop-security-check.mjs",
    "test:native:live-uia": "node scripts/native-live-smoke.mjs uia en",
    "test:native:live-ocr": "node scripts/native-live-smoke.mjs ocr en",
    "test:native:chat-fixture": "node scripts/test-chat-fixture.mjs",
    "smoke:openrouter": "pnpm --filter @milo/web smoke:openrouter",
    "test:smoke:production-contract": "node scripts/smoke-production.contract.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "test:release-check": "node scripts/release-readiness.contract.mjs"
  },
  "devDependencies": {
    "@next/env": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "0.35.3",
    "typescript": "^5"
  }
}
