# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/
/test-results/
/playwright-report/
/artifacts/
/.agents/

# next.js
**/.next/
**/.next-e2e/
**/.next-e2e-dev/
**/out/
**/.vite/
**/make/
apps/desktop/native-runtime/

# production
**/build/
native/**/bin/
native/**/obj/
*.dmp

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
milo-preview.log
milo-preview-error.log

# local credential-bearing command/config scratch files
deepseekspro.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
**/.vercel/

# typescript
*.tsbuildinfo
**/next-env.d.ts
