# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter - server only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Comma-separated reviewed OpenRouter provider IDs; empty fails closed
OPENROUTER_PROVIDER_ALLOWLIST=
OPENROUTER_TIMEOUT_MS=35000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_HASH_SECRET=
# OAuth public client identifier registered for the Windows desktop app
MILO_DESKTOP_CLIENT_ID=
MILO_DESKTOP_REDIRECT_URI=http://127.0.0.1:43821/oauth/callback

# Stripe - server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Comma-separated emails allowed to view /admin
ADMIN_EMAILS=

# Never enable outside automated local tests
MILO_E2E_MODE=false
