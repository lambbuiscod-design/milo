{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@desktop/*": ["src/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/components/primitives/**/*.ts",
    "src/renderer/components/primitives/**/*.tsx",
    "src/types/**/*.d.ts"
  ]
}
