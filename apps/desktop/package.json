{
  "name": "@milo/desktop",
  "productName": "Milo",
  "version": "0.1.0",
  "description": "Secure Windows-first Milo desktop shell",
  "author": "Milo",
  "type": "module",
  "private": true,
  "main": ".vite/build/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:runtime": "install-electron",
    "dev": "pnpm build && electron .",
    "build": "vite build --config vite.renderer.config.ts --configLoader native && vite build --config vite.preload.config.ts --configLoader native && vite build --config vite.main.config.ts --configLoader native",
    "start": "electron .",
    "stage:native": "node ../../scripts/native-build.mjs publish && node scripts/stage-native-runtime.mjs",
    "package": "pnpm stage:native && electron-forge package",
    "make": "pnpm stage:native && electron-forge make",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@milo/test-fixtures": "workspace:*"
  }
}
